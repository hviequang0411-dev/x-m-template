{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tests.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@engine": ["./supabase/functions/_shared/game-engine/index.ts"],
      "@engine/*": ["./supabase/functions/_shared/game-engine/*"],
      "@shared/*": ["./supabase/functions/_shared/*"]
    }
  },
  "include": ["e2e", "tests", "playwright.config.ts", "vitest.integration.config.ts"]
}
